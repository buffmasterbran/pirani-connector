generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model OrderLine {
  id                     Int       @id @default(autoincrement())
  shopifyOrderId         String
  shopifyOrderName       String
  shopifyOrderNumber     Int?
  financialStatus        String
  fulfillmentStatus      String?
  currency               String
  orderCreatedAt         DateTime
  orderUpdatedAt         DateTime?
  orderSubtotal          Float?
  orderTax               Float?
  orderShipping          Float?
  orderDiscount          Float?
  orderTotal             Float?
  netsuiteSalesOrderId   String?
  netsuiteSalesOrderName String?
  netsuiteCashSaleId     String?
  netsuiteCashSaleName   String?
  netsuiteRefundId       String?
  netsuiteRefundName     String?
  netsuiteDepositId      String?
  shopifyPayoutId        String?
  shopifyPayoutStatus    String?
  expectedPayoutAmount   Float?
  actualDepositAmount    Float?
  varianceAmount         Float?
  depositCreatedAt       DateTime?
  syncedShopifyAt        DateTime?
  syncedNetsuiteAt       DateTime?
  status                 String?
  reconciliationStatus   String?
  paymentGatewayNames    String?
  shippingLines          String?
  customerId             String?
  customerEmail          String?
  customerFirstName      String?
  customerLastName       String?
  shippingAddress        String?
  lineItemId             String
  lineItemSku            String?
  lineItemName           String?
  lineItemQuantity       Int?
  lineItemPrice          Float?
  lineItemTotal          Float?
  lineItemNet            Float?
  lineItemMetadata       String?
  tags                   String?   // Comma-separated Shopify order tags
  sourceName             String?   // Shopify order source_name (e.g., 'web', '3890849' for Shop App)
  appId                  Int?      // Shopify app_id
  isDeleted              Boolean   @default(false)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  payoutTransactions PayoutTransaction[]

  @@unique([shopifyOrderId, lineItemId])
  @@index([shopifyPayoutId])
  @@index([netsuiteDepositId])
  @@index([status])
}

model Payout {
  id                String    @id
  status            String?
  currency          String?
  totalAmount       Float?
  payoutDate        DateTime?
  type              String?
  netsuiteDepositId String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  transactions PayoutTransaction[]
}

model PayoutTransaction {
  id                      String    @id
  payoutId                String
  shopifyOrderId          String?
  orderLineId             Int?
  amount                  Float?
  net                     Float?
  fee                     Float?
  type                    String?
  currency                String?
  processedAt             DateTime?
  adjustmentReason        String?
  netsuiteTransactionId   String?
  netsuiteTransactionName String?
  netsuiteAmount          Float?
  amountMismatch          Boolean   @default(false)
  includeInNetSuite       Boolean   @default(true)
  otherFeesDescription    String?
  amountDescription       String?
  feeDescription          String?
  parentTransactionId     String?
  createdAt               DateTime  @default(now())

  payout    Payout              @relation(fields: [payoutId], references: [id], onDelete: Cascade)
  orderLine OrderLine?          @relation(fields: [orderLineId], references: [id])
  parent    PayoutTransaction?  @relation("TransactionSplits", fields: [parentTransactionId], references: [id], onDelete: Cascade)
  children  PayoutTransaction[] @relation("TransactionSplits")

  @@index([payoutId])
  @@index([shopifyOrderId])
  @@index([adjustmentReason])
  @@index([parentTransactionId])
}

model PayoutMapping {
  id                      Int      @id @default(autoincrement())
  mappingType             String // 'deposit_account', 'fees_account', 'fees_description'
  netsuiteId              String // NetSuite account ID or value
  description             String? // Optional description/name
  isActive                Boolean  @default(true)
  isDefaultDepositAccount Boolean  @default(false) // Only one deposit_account can be default
  isDefaultFeesAccount    Boolean  @default(false) // Only one fees_account can be default
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([mappingType])
  @@index([isActive])
  @@index([isDefaultDepositAccount])
  @@index([isDefaultFeesAccount])
}

model PaymentMethodMapping {
  id          Int      @id @default(autoincrement())
  shopifyCode String // Shopify payment method code (e.g., 'shopify_payments', 'visa')
  netsuiteId  String // NetSuite payment method ID
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([shopifyCode])
  @@index([isActive])
}

model ShipmentMethodMapping {
  id          Int      @id @default(autoincrement())
  shopifyCode String // Shopify shipment method code (e.g., 'free_shipping', 'standard_shipping')
  netsuiteId  String // NetSuite shipment method ID
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([shopifyCode])
  @@index([isActive])
}

model OrderSourceMapping {
  id          Int      @id @default(autoincrement())
  appId       Int?     // Shopify app_id (e.g., 2329312, 3890849)
  sourceName  String?  // Shopify source_name (e.g., 'web', 'checkout')
  friendlyName String  // Display name (e.g., 'Facebook', 'Shop App', 'Web')
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([appId])
  @@unique([sourceName])
  @@index([isActive])
  @@index([appId])
  @@index([sourceName])
}

model OrderFieldMapping {
  id                 Int      @id @default(autoincrement())
  mappingType        String // 'Fixed', 'Order Header', 'Order Header with Translation', 'Custom'
  shopifyCode        String? // Shopify field code (e.g., 'order_id', 'payment_gateway_names')
  shopifyValue       String? // Fixed value (e.g., 'Online Sales', 'Unchecked')
  netsuiteId         String // NetSuite Internal ID or field name
  applyToAllAccounts Boolean  @default(true)
  isActive           Boolean  @default(true)
  customFieldId      String? // For custom fields
  translationDefaultValue String? // Default value for Order Header with Translation when no match found
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  translationMappings OrderFieldTranslationMapping[]

  @@index([isActive])
  @@index([mappingType])
}

model OrderFieldTranslationMapping {
  id                 Int      @id @default(autoincrement())
  orderFieldMappingId Int     // Reference to OrderFieldMapping
  shopifyValue       String   // Shopify value (e.g., '55211131032')
  netsuiteValue      String   // NetSuite value (e.g., '1' or NetSuite ID)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  orderFieldMapping OrderFieldMapping @relation(fields: [orderFieldMappingId], references: [id], onDelete: Cascade)

  @@unique([orderFieldMappingId, shopifyValue])
  @@index([orderFieldMappingId])
  @@index([isActive])
}

model OrderItemFieldMapping {
  id                 Int      @id @default(autoincrement())
  mappingType        String // 'Fixed', 'Line Item Field', 'Custom'
  shopifyCode        String? // Shopify line item field code
  shopifyValue       String? // Fixed value
  netsuiteId         String // NetSuite Internal ID or field name
  applyToAllAccounts Boolean  @default(true)
  isActive           Boolean  @default(true)
  customFieldId      String? // For custom fields
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([isActive])
  @@index([mappingType])
}

model CustomerFieldMapping {
  id                 Int      @id @default(autoincrement())
  mappingType        String // 'Fixed', 'Customer Field', 'Custom'
  shopifyCode        String? // Shopify field code (e.g., 'customer_id', 'email')
  shopifyValue       String? // Fixed value
  netsuiteId         String // NetSuite Internal ID or field name
  applyToAllAccounts Boolean  @default(true)
  isActive           Boolean  @default(true)
  customFieldId      String? // For custom fields
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([isActive])
  @@index([mappingType])
}

model Product {
  id                        String    @id // NetSuite Internal ID
  sku                       String?   // NetSuite itemid (SKU)
  name                      String?   // NetSuite displayname
  isInactive                Boolean   @default(false)
  category                  String?   // Category/sync type (e.g., 'ShopifyPriceQty')
  quantityAvailable         Float?    // NetSuite quantityavailable
  createdDate               DateTime?
  lastLoadedFromNetSuite    DateTime?
  lastModifiedInConnector   DateTime?
  lastPushedTo              DateTime?
  lastSourceChange          DateTime?
  isFulfillable             Boolean?
  isOnline                  Boolean?
  itemType                  String?
  saleUnitName              String?
  unitsTypeName             String?
  shopifyInventoryItemId    String?   // Shopify Inventory Item ID (default)
  shopifyProductId          String?   // Shopify Product ID (default)
  shopifyVariantId           String?   // Shopify Variant ID (default)
  rawData                   String?   // JSON string of full product data from NetSuite
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  @@index([sku])
  @@index([category])
  @@index([isInactive])
}

model ProductMapping {
  id               Int      @id @default(autoincrement())
  shopifySku       String? // Shopify SKU
  shopifyProductId String? // Shopify product ID
  netsuiteItemId   String // NetSuite item ID
  netsuiteItemName String? // NetSuite item name
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([shopifySku])
  @@index([shopifyProductId])
  @@index([isActive])
}

model MappingDefaults {
  id           Int      @id @default(autoincrement())
  settingKey   String // Setting key (e.g., 'default_account', 'default_location')
  settingValue String // Setting value
  description  String? // Optional description
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([settingKey])
  @@index([isActive])
}

model Customer {
  id                    Int       @id @default(autoincrement())
  shopifyCustomerId     String    @unique
  adminGraphqlApiId     String?
  createdAt             DateTime
  updatedAt             DateTime?
  firstName             String?
  lastName              String?
  state                 String?
  note                  String?
  verifiedEmail         Boolean   @default(false)
  multipassIdentifier   String?
  taxExempt             Boolean   @default(false)
  emailMarketingConsent String? // JSON string
  smsMarketingConsent   String? // JSON string
  tags                  String?
  email                 String?
  phone                 String?
  currency              String?
  taxExemptions         String? // JSON array string
  netsuiteCustomerId    String? // NetSuite Internal ID
  createdAtDb           DateTime  @default(now())
  updatedAtDb           DateTime  @updatedAt

  addresses CustomerAddress[]

  @@index([shopifyCustomerId])
  @@index([email])
  @@index([netsuiteCustomerId])
}

// ============================================================
// Product Sync Models
// ============================================================

enum ProductSyncMatchStatus {
  matched
  unmatched
  multiple_matches
  error
}

enum ProductSyncStatus {
  pending
  success
  error
  skipped
}

enum SyncType {
  full
  incremental
  manual_single
  manual_all
}

enum SyncRunStatus {
  running
  completed
  completed_with_errors
  failed
}

enum SyncJobType {
  scheduled
  manual
}

enum SyncJobStatus {
  pending
  running
  completed
  failed
}

model ProductSyncStoreConfig {
  id                          String   @id @default(uuid())
  storeName                   String
  storeLabel                  String?
  shopifyDomain               String   @unique
  shopifyAccessTokenEncrypted String
  shopifyApiVersion           String   @default("2025-10")
  netsuiteFlagFieldId         String
  netsuitePriceLevelId        Int
  netsuiteComparePriceLevelId Int?
  syncEnabled                 Boolean  @default(true)
  syncIntervalMinutes         Int      @default(15)
  lowStockThreshold           Int      @default(10)
  lowStockIntervalMinutes     Int      @default(5)
  includeNonInventory         Boolean  @default(false)
  isActive                    Boolean  @default(true)
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  locationMappings ProductSyncLocationMapping[]
  productMappings  ProductSyncMapping[]
  fieldMappings    ProductSyncFieldMapping[]
  syncLogs         ProductSyncLog[]
  syncJobs         ProductSyncJob[]
}

model ProductSyncLocationMapping {
  id                   String   @id @default(uuid())
  storeConfigId        String
  netsuiteLocationId   Int
  netsuiteLocationName String?
  shopifyLocationId    String
  shopifyLocationName  String?
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())

  storeConfig ProductSyncStoreConfig @relation(fields: [storeConfigId], references: [id], onDelete: Cascade)

  @@unique([storeConfigId, netsuiteLocationId, shopifyLocationId])
  @@index([storeConfigId])
}

model ProductSyncMapping {
  id                     String                @id @default(uuid())
  storeConfigId          String
  netsuiteItemId         Int?
  netsuiteSku            String
  netsuiteName           String?
  netsuiteColor          String?
  netsuiteSize           String?
  netsuiteItemType       String?
  shopifyProductId       String?
  shopifyVariantId       String?
  shopifyInventoryItemId String?
  shopifyProductTitle    String?
  shopifyProductHandle   String?
  matchStatus            ProductSyncMatchStatus @default(unmatched)
  netsuiteCurrentPrice   Decimal?               @db.Decimal(10, 2)
  netsuiteCurrentQty     Int?
  lastSyncedPrice        Decimal?               @db.Decimal(10, 2)
  lastSyncedComparePrice Decimal?               @db.Decimal(10, 2)
  lastSyncedQuantity     Int?
  lastSyncAt             DateTime?
  lastSyncStatus         ProductSyncStatus      @default(pending)
  lastSyncError          String?
  netsuiteFlagValue      String?
  netsuiteExtraFields    Json?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  storeConfig ProductSyncStoreConfig @relation(fields: [storeConfigId], references: [id], onDelete: Cascade)

  @@unique([storeConfigId, netsuiteSku])
  @@index([netsuiteSku])
  @@index([matchStatus])
  @@index([lastSyncStatus])
  @@index([storeConfigId])
}

model ProductSyncLog {
  id              String        @id @default(uuid())
  storeConfigId   String?
  syncType        SyncType
  startedAt       DateTime      @default(now())
  completedAt     DateTime?
  status          SyncRunStatus @default(running)
  itemsProcessed  Int           @default(0)
  itemsUpdated    Int           @default(0)
  itemsSkipped    Int           @default(0)
  itemsErrored    Int           @default(0)
  priceUpdates    Int           @default(0)
  quantityUpdates Int           @default(0)
  errorSummary    Json?
  durationMs      Int?
  createdAt       DateTime      @default(now())

  storeConfig ProductSyncStoreConfig? @relation(fields: [storeConfigId], references: [id])
  syncJobs    ProductSyncJob[]

  @@index([storeConfigId])
  @@index([startedAt(sort: Desc)])
}

model ProductSyncJob {
  id            String        @id @default(uuid())
  storeConfigId String
  jobType       SyncJobType
  status        SyncJobStatus @default(pending)
  nextRunAt     DateTime?
  lastRunAt     DateTime?
  lastRunLogId  String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  storeConfig ProductSyncStoreConfig @relation(fields: [storeConfigId], references: [id], onDelete: Cascade)
  lastRunLog  ProductSyncLog?        @relation(fields: [lastRunLogId], references: [id])

  @@unique([storeConfigId, jobType])
  @@index([storeConfigId])
}

model CachedNetSuiteLocation {
  id        Int      @id
  name      String
  fetchedAt DateTime @default(now())
}

model CachedNetSuitePriceLevel {
  id        Int      @id
  name      String
  fetchedAt DateTime @default(now())
}

model ProductSyncFieldMapping {
  id              String   @id @default(uuid())
  storeConfigId   String?
  mappingType     String   // "flag_field" | "special" | "item_field"
  shopifyField    String   // e.g., "price", "inventory_quantity", "title", "sku"
  netsuiteFieldId String?  // e.g., "itemid", "displayname", "salesDescription"
  defaultValue    String?
  isRequired      Boolean  @default(false)
  isEnabled       Boolean  @default(true)
  sortOrder       Int      @default(0)
  category        String   @default("standard") // "required" | "standard" | "uncommon"
  specialConfig   Json?    // For special mappings: { priceLevelId, locationId, etc. }
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  storeConfig ProductSyncStoreConfig? @relation(fields: [storeConfigId], references: [id], onDelete: Cascade)

  @@unique([storeConfigId, shopifyField])
  @@index([storeConfigId])
}

model WebhookLog {
  id              Int      @id @default(autoincrement())
  endpoint        String
  method          String   @default("POST")
  requestPayload  Json?
  responsePayload Json?
  responseStatus  Int?
  durationMs      Int?
  source          String?
  itemCount       Int?
  summary         String?
  createdAt       DateTime @default(now())

  @@index([endpoint])
  @@index([createdAt(sort: Desc)])
}

model Fulfillment {
  id                    Int       @id @default(autoincrement())
  shopifyOrderId        String
  netsuiteSoId          String?
  netsuiteIfId          String    @unique
  shopifyFulfillmentId  String?
  trackingNumber        String?
  carrier               String?
  shippedDate           DateTime?
  lineItems             Json?
  status                String    @default("synced")
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([shopifyOrderId])
  @@index([netsuiteSoId])
  @@index([status])
}

model TransactionAuditLog {
  id              Int      @id @default(autoincrement())
  transactionId   String
  payoutId        String
  action          String   // merge, split, split_delete, toggle_include, set_amount_desc, set_fee_desc, set_other_fees_desc, add_netsuite, clear_netsuite, reassign_netsuite
  details         Json?    // { before: {...}, after: {...}, sourceIds: [...], etc. }
  createdAt       DateTime @default(now())

  @@index([transactionId])
  @@index([payoutId])
  @@index([createdAt(sort: Desc)])
}

model CustomerAddress {
  id                Int      @id @default(autoincrement())
  customerId        Int
  shopifyAddressId  String?
  isDefaultBilling  Boolean  @default(false)
  isDefaultShipping Boolean  @default(false)
  isSavedAddress    Boolean  @default(false) // Address saved in Shopify customer account
  firstName         String?
  lastName          String?
  company           String?
  address1          String?
  address2          String?
  city              String?
  zip               String?
  province          String?
  country           String?
  provinceCode      String?
  countryCode       String?
  countryName       String?
  phone             String?
  name              String?
  latitude          Float?
  longitude         Float?
  isDefault         Boolean  @default(false) // Legacy field, kept for compatibility
  netsuiteAddressId String? // NetSuite Internal ID
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([shopifyAddressId])
  @@index([isDefaultBilling])
  @@index([isDefaultShipping])
  @@index([isSavedAddress])
  @@index([netsuiteAddressId])
}
